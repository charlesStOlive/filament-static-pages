{
    "name": "charlesstolive/filament-static-pages",
    "description": "Static pages and block editor plugin for Filament.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "CharlesStOlive\\FilamentStaticPages\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CharlesStOlive\\FilamentStaticPages\\FilamentStaticPagesServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/view": "^13.0",
        "livewire/livewire": "^4.0",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
